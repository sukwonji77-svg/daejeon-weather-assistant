FIREBASE_PROJECT_ID=your-firebase-project-id
GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/your/service-account.json
# Render에서는 파일 경로 대신 FIREBASE_SERVICE_ACCOUNT_JSON을 비공개 환경변수로 설정할 수 있습니다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# API_BASE_URL은 Vercel의 공개 환경변수로만 설정합니다. 로컬 화면에서는 필요하지 않습니다.
APP_ACCESS_TOKEN=
# Render에서는 위 접속 암호를 16자 이상으로 반드시 설정합니다. OpenAI API 키와 별개입니다.
